    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
