# Copy this file to .env.local for local server development.
# .env.local is gitignored and must never be committed.
#
# LLM_PROVIDER selects which provider server/api/analyze-assessment.mjs uses.
# "mock" is the safe default and requires no credentials or network access.
LLM_PROVIDER=mock

# Only required if LLM_PROVIDER=openai. Never commit a real value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only required if LLM_PROVIDER=claude. Never commit a real value.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# EMAIL_PROVIDER selects which provider server/email/email-service.mjs uses.
# "mock" is the safe default and requires no credentials or network access.
EMAIL_PROVIDER=mock

# Only required if EMAIL_PROVIDER=brevo. Never commit real values.
# Sandbox defaults to true and validates requests without delivering email.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=HUMA Labs
BREVO_SANDBOX=true

# Internal recipient for the contact form. Required for /api/contact to send
# anything (with no value, the endpoint safely refuses rather than silently
# dropping the message or guessing a recipient).
CONTACT_NOTIFICATION_EMAIL=

# Only required if EMAIL_PROVIDER=smtp. Never commit real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
